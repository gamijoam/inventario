# ============================================
# SECURITY CONFIGURATION
# ============================================
# CRITICAL: Generate a new SECRET_KEY using: python generate_key.py
# This key is used for JWT token signing and must be kept secret
SECRET_KEY=REPLACE_THIS_WITH_OUTPUT_FROM_generate_key_py

# JWT Configuration
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ============================================
# DATABASE CONFIGURATION
# ============================================
# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ferreteria_db

# Alternative naming (both are supported)
# DB_URL=postgresql://postgres:postgres@localhost:5432/ferreteria_db

# ============================================
# MODULE TOGGLES
# ============================================
MODULE_RESTAURANT_ENABLED=false
MODULE_SERVICES_ENABLED=false
MODULE_LAUNDRY_ENABLED=false

# ============================================
# LOCALIZATION
# ============================================
TIMEZONE=America/Caracas

# ============================================
# DEPLOYMENT MODE
# ============================================
# Set to "true" when running in Docker/VPS (disables license guard)
# DOCKER_CONTAINER=false
