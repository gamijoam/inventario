# ============================================
# SECURITY CONFIGURATION — REQUIRED
# ============================================
# CRITICAL: Generate a strong key before deploying. Run:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# The application will REFUSE TO START if this variable is not set.
# NEVER use a guessable value. NEVER commit the real .env file.
SECRET_KEY=REPLACE_WITH_OUTPUT_OF_secrets.token_urlsafe_64

# JWT Configuration
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ============================================
# DATABASE CONFIGURATION — REQUIRED
# ============================================
# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/ferreteria_db

# ============================================
# APPLICATION SETTINGS
# ============================================
ENVIRONMENT=production
APP_DOMAIN=miinventariofacil.com
PROTOCOL=https
TIMEZONE=America/Caracas

# ============================================
# COOKIES & SESSION
# ============================================
# Set to your root domain with leading dot for multi-tenant (e.g. .miinventariofacil.com)
COOKIE_DOMAIN=.miinventariofacil.com
# Must be True in production (HTTPS required)
SECURE_COOKIES=true

# ============================================
# MEDIA STORAGE
# ============================================
MEDIA_ROOT=/app/media

# ============================================
# MODULE TOGGLES
# ============================================
MODULE_RESTAURANT_ENABLED=false
MODULE_SERVICES_ENABLED=false
MODULE_LAUNDRY_ENABLED=false

# ============================================
# FEATURE FLAGS
# ============================================
ENABLE_LOCAL_SYNC=false

# ============================================
# EMAIL / SMTP (optional — leave blank to disable)
# ============================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASSWORD=CHANGE_ME
EMAILS_FROM_EMAIL=noreply@example.com
EMAILS_FROM_NAME=Inventario Facil
SMTP_TLS=true
SMTP_SSL=false

# ============================================
# FRONTEND URL (for CORS and email links)
# ============================================
FRONTEND_URL=https://app.miinventariofacil.com

# ============================================
# DEPLOYMENT
# ============================================
# Set to "true" when running inside Docker/VPS
DOCKER_CONTAINER=false

# ─── SISTEMA DE LICENCIAS ────────────────────────────────────────────────────

# Modo de licencia: OFFLINE (hardware lock) | CLOUD (dominio lock)
LICENSE_MODE=CLOUD

# Clave JWT de licencia del servidor (para modo CLOUD, inyectar en docker)
# LICENSE_KEY=eyJ...

# Días de trial para nuevos tenants (configurable por admin SaaS)
LICENSE_TRIAL_DAYS_DEFAULT=15

# Días de gracia offline después del vencimiento de licencia desktop
LICENSE_GRACE_DAYS_OFFLINE=7

# Claves RS256 para firmar/verificar tokens de licencia desktop
# LICENSE_RS256_PRIVATE_KEY=<clave_privada_PEM>
# LICENSE_RS256_PUBLIC_KEY=<clave_publica_PEM>
