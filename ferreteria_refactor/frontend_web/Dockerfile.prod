# ETAPA 1: Tests
FROM node:22.14-alpine3.21 AS test-stage

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm install --legacy-peer-deps

COPY . .

# Falla el build si algún test falla
RUN npx jest src/__tests__/ --no-coverage --ci

# ETAPA 2: Construcción (Build)
FROM node:22.14-alpine3.21 AS build-stage

WORKDIR /app

# Copiamos package.json e instalamos dependencias
COPY package.json package-lock.json ./
RUN npm install --legacy-peer-deps

# Copiamos el código fuente
COPY . .

# ARGUMENTOS DE CONSTRUCCIÓN (Crucial para que Vite capture la variable durante el build)
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL

RUN echo "VITE_API_URL set to: $VITE_API_URL"

# Ejecutamos el build (crea la carpeta /dist)
RUN npm run build

# ETAPA 2: Producción (Nginx)
FROM nginx:1.27-alpine3.21 AS production-stage

# Copiamos los archivos compilados de la etapa anterior a Nginx
COPY --from=build-stage /app/dist /usr/share/nginx/html

# Copiamos nuestra configuración personalizada de Nginx
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Note: nginx master process requires root for port 80 binding.
# Worker processes already run as non-root 'nginx' user via nginx.conf default.

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]