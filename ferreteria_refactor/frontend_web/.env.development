# Backend API URL (solo para desarrollo local si el proxy falla)
VITE_API_URL=http://127.0.0.1:8000/api/v1
# Servidor de licencias desktop (siempre VPS, nunca localhost)
VITE_LICENSE_SERVER=https://api-qa.miinventariofacil.com
# Forzar todos los módulos visibles en el Sidebar durante desarrollo local.
# Cambiar a false (o eliminar) para probar con los feature flags reales del backend.
VITE_FORCE_ALL_MODULES=true
