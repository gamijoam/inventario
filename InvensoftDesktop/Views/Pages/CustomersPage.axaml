<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:InvensoftDesktop.ViewModels"
             x:Class="InvensoftDesktop.Views.Pages.CustomersPage"
             x:DataType="vm:CustomersViewModel">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Búsqueda -->
        <Border Grid.Row="0" Background="White" Padding="20 14"
                BorderThickness="0 0 0 1" BorderBrush="#E2E8F0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBox Grid.Column="0" Text="{Binding SearchText}"
                         Watermark="Buscar por nombre, RIF/CI, teléfono…"
                         CornerRadius="8" Padding="12 8" FontSize="13"/>
                <Button Grid.Column="1" Command="{Binding SearchCommand}"
                        Margin="10 0 0 0" CornerRadius="8" Padding="16 8"
                        Background="#4F46E5" Foreground="White"
                        FontWeight="SemiBold" FontSize="13">
                    Buscar
                </Button>
            </Grid>
        </Border>

        <!-- Lista -->
        <ScrollViewer Grid.Row="1">
            <StackPanel>
                <TextBlock Text="Cargando clientes…" Margin="24 16"
                           FontSize="13" Foreground="#94A3B8"
                           IsVisible="{Binding IsLoading}"/>
                <Border Background="#FEF2F2" CornerRadius="8" Padding="14 10"
                        Margin="20 12"
                        IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" FontSize="13"/>
                </Border>

                <!-- Encabezado -->
                <Border Background="#F8FAFC" Padding="20 10"
                        BorderThickness="0 0 0 1" BorderBrush="#E2E8F0">
                    <Grid ColumnDefinitions="*,110,110,80,80">
                        <TextBlock Grid.Column="0" Text="Nombre"         FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                        <TextBlock Grid.Column="1" Text="RIF / CI"       FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                        <TextBlock Grid.Column="2" Text="Teléfono"       FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                        <TextBlock Grid.Column="3" Text="Crédito"        FontSize="11" FontWeight="SemiBold" Foreground="#64748B" TextAlignment="Right"/>
                        <TextBlock Grid.Column="4" Text="Estado"         FontSize="11" FontWeight="SemiBold" Foreground="#64748B" TextAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Filas -->
                <ItemsControl ItemsSource="{Binding Customers}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="20 11"
                                    BorderThickness="0 0 0 1" BorderBrush="#F1F5F9">
                                <Grid ColumnDefinitions="*,110,110,80,80">
                                    <TextBlock Grid.Column="0" Text="{Binding Name}"
                                               FontSize="13" FontWeight="SemiBold" Foreground="#1E293B"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1" Text="{Binding IdNumber}"
                                               FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Phone}"
                                               FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="{Binding CreditDisplay}"
                                               FontSize="12" FontWeight="SemiBold" Foreground="#1E293B"
                                               TextAlignment="Right" VerticalAlignment="Center"/>
                                    <Border Grid.Column="4" CornerRadius="6" Padding="6 3"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Background="#F1F5F9">
                                        <TextBlock Text="{Binding StatusDisplay}"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{Binding StatusColor}"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="White" Padding="20 10"
                BorderThickness="0 1 0 0" BorderBrush="#E2E8F0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" FontSize="12" Foreground="#64748B" VerticalAlignment="Center">
                    <Run Text="{Binding Customers.Count}"/>
                    <Run Text=" de "/>
                    <Run Text="{Binding TotalCount}"/>
                    <Run Text=" clientes"/>
                </TextBlock>
                <Button Grid.Column="1" Command="{Binding LoadMoreCommand}"
                        IsVisible="{Binding HasMore}" IsEnabled="{Binding !IsLoading}"
                        CornerRadius="8" Padding="14 7"
                        Background="#EEF2FF" Foreground="#4F46E5"
                        FontWeight="SemiBold" FontSize="12">
                    Cargar más
                </Button>
            </Grid>
        </Border>

    </Grid>
</UserControl>
