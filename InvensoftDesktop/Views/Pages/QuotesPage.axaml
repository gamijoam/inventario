<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:InvensoftDesktop.ViewModels"
             x:Class="InvensoftDesktop.Views.Pages.QuotesPage"
             x:DataType="vm:QuotesViewModel">

    <Grid RowDefinitions="*,Auto">

        <ScrollViewer Grid.Row="0">
            <StackPanel>
                <TextBlock Text="Cargando cotizaciones…" Margin="20 14" FontSize="13" Foreground="#94A3B8" IsVisible="{Binding IsLoading}"/>
                <Border Background="#FEF2F2" CornerRadius="8" Padding="12 8" Margin="20 10"
                        IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" FontSize="12"/>
                </Border>
                <Border Background="#F0FDF4" CornerRadius="8" Padding="12 8" Margin="20 10"
                        IsVisible="{Binding SuccessMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock Text="{Binding SuccessMessage}" Foreground="#15803D" FontSize="12"/>
                </Border>

                <!-- Encabezado -->
                <Border Background="#F8FAFC" Padding="20 9" BorderThickness="0 0 0 1" BorderBrush="#E2E8F0">
                    <Grid ColumnDefinitions="60,*,120,100,80,120">
                        <TextBlock Grid.Column="0" Text="#"          FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                        <TextBlock Grid.Column="1" Text="Cliente"    FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                        <TextBlock Grid.Column="2" Text="Fecha"      FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                        <TextBlock Grid.Column="3" Text="Total"      FontSize="11" FontWeight="SemiBold" Foreground="#64748B" TextAlignment="Right"/>
                        <TextBlock Grid.Column="4" Text="Estado"     FontSize="11" FontWeight="SemiBold" Foreground="#64748B" TextAlignment="Center"/>
                        <TextBlock Grid.Column="5" Text="Acciones"   FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                    </Grid>
                </Border>

                <!-- Filas -->
                <ItemsControl ItemsSource="{Binding Quotes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="20 11" BorderThickness="0 0 0 1" BorderBrush="#F1F5F9">
                                <Grid ColumnDefinitions="60,*,120,100,80,120">
                                    <TextBlock Grid.Column="0" Text="{Binding Id}"
                                               FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding CustomerName}"
                                               FontSize="13" FontWeight="SemiBold" Foreground="#1E293B"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2" Text="{Binding DateDisplay}"
                                               FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="{Binding TotalDisplay}"
                                               FontSize="13" FontWeight="Bold" Foreground="#059669"
                                               TextAlignment="Right" VerticalAlignment="Center"/>
                                    <Border Grid.Column="4" CornerRadius="6" Padding="6 3"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Background="#F1F5F9">
                                        <TextBlock Text="{Binding StatusDisplay}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{Binding StatusColor}"/>
                                    </Border>
                                    <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <Button CommandParameter="{Binding}"
                                                CornerRadius="6" Padding="6 4"
                                                Background="#EEF2FF" Foreground="#4F46E5"
                                                FontSize="11" ToolTip.Tip="Imprimir">
                                            🖨
                                        </Button>
                                        <Button CommandParameter="{Binding}"
                                                CornerRadius="6" Padding="6 4"
                                                Background="#F0FDF4" Foreground="#059669"
                                                FontSize="11" ToolTip.Tip="Convertir en venta">
                                            ✓ Venta
                                        </Button>
                                        <Button CommandParameter="{Binding}"
                                                CornerRadius="6" Padding="6 4"
                                                Background="#FEF2F2" Foreground="#DC2626"
                                                FontSize="11" ToolTip.Tip="Eliminar">
                                            ✕
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="1" Background="White" Padding="20 10" BorderThickness="0 1 0 0" BorderBrush="#E2E8F0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" FontSize="12" Foreground="#64748B" VerticalAlignment="Center">
                    <Run Text="{Binding Quotes.Count}"/>
                    <Run Text=" de "/>
                    <Run Text="{Binding TotalCount}"/>
                    <Run Text=" cotizaciones"/>
                </TextBlock>
                <Button Grid.Column="1" Command="{Binding LoadMoreCommand}"
                        IsVisible="{Binding HasMore}" IsEnabled="{Binding !IsLoading}"
                        CornerRadius="8" Padding="14 7" Background="#EEF2FF" Foreground="#4F46E5"
                        FontWeight="SemiBold" FontSize="12">
                    Cargar más
                </Button>
            </Grid>
        </Border>

    </Grid>
</UserControl>
