<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:InvensoftDesktop.ViewModels"
             x:Class="InvensoftDesktop.Views.Pages.DashboardPage"
             x:DataType="vm:DashboardViewModel">

    <ScrollViewer>
        <StackPanel Margin="28" Spacing="24">

            <!-- Saludo -->
            <StackPanel Spacing="4">
                <TextBlock Text="{Binding Greeting}"
                           FontSize="22" FontWeight="Black" Foreground="#1E293B"/>
                <TextBlock Text="Resumen de hoy"
                           FontSize="14" Foreground="#64748B"/>
            </StackPanel>

            <!-- Loading -->
            <TextBlock Text="Cargando datos..."
                       FontSize="14" Foreground="#94A3B8"
                       IsVisible="{Binding IsLoading}"/>

            <!-- Error -->
            <Border Background="#FEF2F2" CornerRadius="10" Padding="16"
                    IsVisible="{Binding ErrorMessage,
                        Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="#DC2626" FontSize="13"/>
            </Border>

            <!-- Sin datos -->
            <Border Background="#F8FAFC" CornerRadius="12" Padding="28"
                    IsVisible="{Binding !HasData}">
                <StackPanel Spacing="6" HorizontalAlignment="Center">
                    <TextBlock Text="Sin datos hoy"
                               FontSize="16" FontWeight="Bold" Foreground="#94A3B8"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Aun no hay ventas registradas para hoy."
                               FontSize="13" Foreground="#CBD5E1"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Stats Cards -->
            <WrapPanel Orientation="Horizontal" IsVisible="{Binding HasData}">

                <!-- Ventas -->
                <Border Background="White" CornerRadius="12" Padding="20"
                        Margin="0 0 16 16" Width="220"
                        BoxShadow="0 2 12 0 #10000000">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Ventas hoy" FontSize="12"
                                   FontWeight="SemiBold" Foreground="#64748B"/>
                        <TextBlock Text="{Binding TotalSales}"
                                   FontSize="28" FontWeight="Black" Foreground="#1E293B"/>
                        <TextBlock Text="transacciones"
                                   FontSize="12" Foreground="#94A3B8"/>
                    </StackPanel>
                </Border>

                <!-- Ingresos USD -->
                <Border Background="White" CornerRadius="12" Padding="20"
                        Margin="0 0 16 16" Width="220"
                        BoxShadow="0 2 12 0 #10000000">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Ingresos (USD base)" FontSize="12"
                                   FontWeight="SemiBold" Foreground="#64748B"/>
                        <TextBlock Text="{Binding TotalRevenue, StringFormat=\{0:F2\}}"
                                   FontSize="28" FontWeight="Black" Foreground="#059669"/>
                        <TextBlock Text="dolares equivalentes"
                                   FontSize="12" Foreground="#94A3B8"/>
                    </StackPanel>
                </Border>

                <!-- Costo -->
                <Border Background="White" CornerRadius="12" Padding="20"
                        Margin="0 0 16 16" Width="220"
                        BoxShadow="0 2 12 0 #10000000">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Costo estimado" FontSize="12"
                                   FontWeight="SemiBold" Foreground="#64748B"/>
                        <TextBlock Text="{Binding TotalCost, StringFormat=\{0:F2\}}"
                                   FontSize="28" FontWeight="Black" Foreground="#DC2626"/>
                        <TextBlock Text="costo de ventas (USD)"
                                   FontSize="12" Foreground="#94A3B8"/>
                    </StackPanel>
                </Border>

                <!-- Ganancia -->
                <Border Background="#F0FDF4" CornerRadius="12" Padding="20"
                        Margin="0 0 16 16" Width="220"
                        BorderThickness="1" BorderBrush="#BBF7D0"
                        BoxShadow="0 2 12 0 #10000000">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Ganancia estimada" FontSize="12"
                                   FontWeight="SemiBold" Foreground="#166534"/>
                        <TextBlock Text="{Binding GrossProfit, StringFormat=\{0:F2\}}"
                                   FontSize="28" FontWeight="Black" Foreground="#15803D"/>
                        <TextBlock Text="ganancia bruta (USD)"
                                   FontSize="12" Foreground="#4ADE80"/>
                    </StackPanel>
                </Border>

            </WrapPanel>

            <!-- Desglose por moneda -->
            <Border Background="White" CornerRadius="14" Padding="0"
                    BoxShadow="0 2 12 0 #10000000"
                    IsVisible="{Binding HasData}">
                <StackPanel Spacing="0">

                    <!-- Encabezado tabla -->
                    <Border Background="#F8FAFC" CornerRadius="14 14 0 0" Padding="20 12"
                            BorderThickness="0 0 0 1" BorderBrush="#E2E8F0">
                        <Grid ColumnDefinitions="*,120,120,80">
                            <TextBlock Grid.Column="0" Text="Moneda"
                                       FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                            <TextBlock Grid.Column="1" Text="Cobrado"
                                       FontSize="11" FontWeight="SemiBold" Foreground="#64748B"
                                       TextAlignment="Right"/>
                            <TextBlock Grid.Column="2" Text="Devoluciones"
                                       FontSize="11" FontWeight="SemiBold" Foreground="#64748B"
                                       TextAlignment="Right"/>
                            <TextBlock Grid.Column="3" Text="Ventas"
                                       FontSize="11" FontWeight="SemiBold" Foreground="#64748B"
                                       TextAlignment="Right"/>
                        </Grid>
                    </Border>

                    <!-- Filas por moneda -->
                    <ItemsControl ItemsSource="{Binding SalesByCurrency}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="20 12"
                                        BorderThickness="0 0 0 1" BorderBrush="#F1F5F9">
                                    <Grid ColumnDefinitions="*,120,120,80">
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding CurrencyLabel}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="#1E293B" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding CollectedDisplay}"
                                                   FontSize="13" Foreground="#059669"
                                                   FontWeight="SemiBold"
                                                   TextAlignment="Right" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding ReturnsDisplay}"
                                                   FontSize="12" Foreground="#DC2626"
                                                   TextAlignment="Right" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding Count}"
                                                   FontSize="13" Foreground="#64748B"
                                                   TextAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
