<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:InvensoftDesktop.ViewModels"
             x:Class="InvensoftDesktop.Views.Pages.PurchasesPage"
             x:DataType="vm:PurchasesViewModel">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Filtros -->
        <Border Grid.Row="0" Background="White" Padding="16 12"
                BorderThickness="0 0 0 1" BorderBrush="#E2E8F0">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Filtrar:" FontSize="13" Foreground="#64748B"
                           VerticalAlignment="Center"/>
                <Button Command="{Binding FilterAllCommand}"
                        CornerRadius="8" Padding="12 7"
                        Background="#EEF2FF" Foreground="#4F46E5"
                        FontWeight="SemiBold" FontSize="12">
                    Todas
                </Button>
                <Button Command="{Binding FilterPendingCommand}"
                        CornerRadius="8" Padding="12 7"
                        Background="#FEF2F2" Foreground="#DC2626"
                        FontWeight="SemiBold" FontSize="12">
                    Pendientes
                </Button>
                <Button Command="{Binding FilterPaidCommand}"
                        CornerRadius="8" Padding="12 7"
                        Background="#F0FDF4" Foreground="#059669"
                        FontWeight="SemiBold" FontSize="12">
                    Pagadas
                </Button>
            </StackPanel>
        </Border>

        <!-- Lista -->
        <ScrollViewer Grid.Row="1">
            <StackPanel>
                <TextBlock Text="Cargando compras…" Margin="24 16"
                           FontSize="13" Foreground="#94A3B8"
                           IsVisible="{Binding IsLoading}"/>
                <Border Background="#FEF2F2" CornerRadius="8" Padding="14 10"
                        Margin="20 12"
                        IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" FontSize="13"/>
                </Border>

                <!-- Encabezado -->
                <Border Background="#F8FAFC" Padding="20 10"
                        BorderThickness="0 0 0 1" BorderBrush="#E2E8F0">
                    <Grid ColumnDefinitions="80,*,100,90,90,80">
                        <TextBlock Grid.Column="0" Text="Fecha"      FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                        <TextBlock Grid.Column="1" Text="Proveedor"  FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                        <TextBlock Grid.Column="2" Text="Factura"    FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                        <TextBlock Grid.Column="3" Text="Total"      FontSize="11" FontWeight="SemiBold" Foreground="#64748B" TextAlignment="Right"/>
                        <TextBlock Grid.Column="4" Text="Pendiente"  FontSize="11" FontWeight="SemiBold" Foreground="#64748B" TextAlignment="Right"/>
                        <TextBlock Grid.Column="5" Text="Estado"     FontSize="11" FontWeight="SemiBold" Foreground="#64748B" TextAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Filas -->
                <ItemsControl ItemsSource="{Binding Purchases}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="20 11"
                                    BorderThickness="0 0 0 1" BorderBrush="#F1F5F9">
                                <Grid ColumnDefinitions="80,*,100,90,90,80">
                                    <TextBlock Grid.Column="0" Text="{Binding DateDisplay}"
                                               FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SupplierName}"
                                               FontSize="13" FontWeight="SemiBold" Foreground="#1E293B"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2" Text="{Binding InvoiceNumber}"
                                               FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="{Binding TotalDisplay}"
                                               FontSize="12" FontWeight="SemiBold" Foreground="#1E293B"
                                               TextAlignment="Right" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="{Binding PendingDisplay}"
                                               FontSize="12" FontWeight="SemiBold" Foreground="#DC2626"
                                               TextAlignment="Right" VerticalAlignment="Center"/>
                                    <Border Grid.Column="5" CornerRadius="6" Padding="6 3"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Background="#F1F5F9">
                                        <TextBlock Text="{Binding StatusDisplay}"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{Binding StatusColor}"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="White" Padding="20 10"
                BorderThickness="0 1 0 0" BorderBrush="#E2E8F0">
            <TextBlock FontSize="12" Foreground="#64748B">
                <Run Text="{Binding Purchases.Count}"/>
                <Run Text=" compras"/>
            </TextBlock>
        </Border>

    </Grid>
</UserControl>
