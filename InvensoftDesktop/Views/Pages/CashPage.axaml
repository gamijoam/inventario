<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:InvensoftDesktop.ViewModels"
             x:Class="InvensoftDesktop.Views.Pages.CashPage"
             x:DataType="vm:CashViewModel">

    <ScrollViewer>
        <StackPanel Margin="28" Spacing="20" MaxWidth="520">

            <!-- Titulo -->
            <StackPanel Spacing="2">
                <TextBlock Text="Caja" FontSize="22" FontWeight="Black" Foreground="#1E293B"/>
                <TextBlock Text="Administra la sesion de caja y movimientos"
                           FontSize="13" Foreground="#64748B"/>
            </StackPanel>

            <!-- Loading -->
            <TextBlock Text="Cargando caja..."
                       FontSize="13" Foreground="#94A3B8"
                       IsVisible="{Binding IsLoading}"/>

            <!-- Error -->
            <Border Background="#FEF2F2" CornerRadius="8" Padding="14 10"
                    IsVisible="{Binding ErrorMessage,
                        Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="#DC2626" FontSize="13"/>
            </Border>

            <!-- Success -->
            <Border Background="#F0FDF4" CornerRadius="8" Padding="14 10"
                    IsVisible="{Binding SuccessMessage,
                        Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding SuccessMessage}"
                           Foreground="#15803D" FontSize="13"/>
            </Border>

            <!-- === CAJA CERRADA === -->
            <Border Background="White" CornerRadius="14" Padding="28"
                    BoxShadow="0 2 12 0 #10000000"
                    IsVisible="{Binding IsClosed}">
                <StackPanel Spacing="18">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Caja cerrada"
                                   FontSize="18" FontWeight="Black" Foreground="#1E293B"/>
                        <TextBlock Text="Ingresa el monto inicial para abrir la sesion."
                                   FontSize="13" Foreground="#64748B"/>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Monto inicial (USD)" FontSize="12"
                                   FontWeight="SemiBold" Foreground="#64748B"/>
                        <TextBox Text="{Binding OpeningAmountText}"
                                 Watermark="0.00"
                                 CornerRadius="8" Padding="12 10" FontSize="14"/>
                    </StackPanel>

                    <Button Command="{Binding OpenSessionCommand}"
                            IsEnabled="{Binding !IsLoading}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            CornerRadius="8" Padding="12 13"
                            Background="#059669" Foreground="White"
                            FontWeight="Bold" FontSize="14">
                        Abrir Caja
                    </Button>
                </StackPanel>
            </Border>

            <!-- === CAJA ABIERTA === -->
            <StackPanel Spacing="16" IsVisible="{Binding IsOpen}">

                <!-- Info de sesion -->
                <Border Background="White" CornerRadius="14" Padding="24"
                        BoxShadow="0 2 12 0 #10000000">
                    <StackPanel Spacing="14">

                        <StackPanel Spacing="4">
                            <TextBlock Text="Caja abierta"
                                       FontSize="18" FontWeight="Black" Foreground="#059669"/>
                            <TextBlock Text="La sesion de caja esta activa."
                                       FontSize="13" Foreground="#64748B"/>
                        </StackPanel>

                        <Border Background="#F0FDF4" CornerRadius="8" Padding="16">
                            <StackPanel Spacing="10">
                                <!-- ID sesion -->
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="ID de sesion"
                                               FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding CurrentSession.Id}"
                                               FontSize="12" FontWeight="SemiBold" Foreground="#1E293B"/>
                                </Grid>
                                <!-- Caja registradora -->
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="Caja registradora"
                                               FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding CurrentSession.RegisterName}"
                                               FontSize="12" FontWeight="SemiBold" Foreground="#1E293B"/>
                                </Grid>
                                <!-- Apertura -->
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="Apertura"
                                               FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding CurrentSession.OpenedAtDisplay}"
                                               FontSize="12" FontWeight="SemiBold" Foreground="#1E293B"/>
                                </Grid>
                                <!-- Monto inicial -->
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="Monto inicial (USD)"
                                               FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding CurrentSession.OpeningAmount, StringFormat=\{0:F2\}}"
                                               FontSize="13" FontWeight="Black" Foreground="#059669"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </Border>

                <!-- Movimientos -->
                <Border Background="White" CornerRadius="14" Padding="0"
                        BoxShadow="0 2 12 0 #10000000">
                    <StackPanel Spacing="0">

                        <!-- Encabezado movimientos -->
                        <Border Background="#F8FAFC" CornerRadius="14 14 0 0" Padding="20 12"
                                BorderThickness="0 0 0 1" BorderBrush="#E2E8F0">
                            <TextBlock Text="Movimientos de caja"
                                       FontSize="13" FontWeight="SemiBold" Foreground="#1E293B"/>
                        </Border>

                        <!-- Sin movimientos -->
                        <Border Padding="24" IsVisible="{Binding !HasMovements}">
                            <TextBlock Text="Sin movimientos en esta sesion."
                                       FontSize="13" Foreground="#94A3B8"
                                       HorizontalAlignment="Center"/>
                        </Border>

                        <!-- Lista de movimientos -->
                        <ItemsControl ItemsSource="{Binding Movements}"
                                      IsVisible="{Binding HasMovements}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="20 10"
                                            BorderThickness="0 0 0 1" BorderBrush="#F1F5F9">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <!-- Badge tipo -->
                                            <Border Grid.Column="0" CornerRadius="6" Padding="7 3"
                                                    Margin="0 0 12 0" VerticalAlignment="Center"
                                                    Background="{Binding TypeColor}">
                                                <TextBlock Text="{Binding TypeDisplay}"
                                                           FontSize="10" FontWeight="Bold"
                                                           Foreground="White"/>
                                            </Border>
                                            <!-- Descripcion + fecha -->
                                            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Description}"
                                                           FontSize="12" Foreground="#1E293B"/>
                                                <TextBlock Text="{Binding Date, StringFormat=\{0:dd/MM HH:mm\}}"
                                                           FontSize="11" Foreground="#94A3B8"/>
                                            </StackPanel>
                                            <!-- Monto -->
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding AmountDisplay}"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{Binding TypeColor}"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </Border>

                <!-- Cerrar caja -->
                <Border Background="White" CornerRadius="14" Padding="24"
                        BoxShadow="0 2 12 0 #10000000"
                        BorderThickness="1" BorderBrush="#FEE2E2">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Cerrar sesion de caja"
                                       FontSize="15" FontWeight="Bold" Foreground="#1E293B"/>
                            <TextBlock Text="Ingresa el efectivo contado al cierre."
                                       FontSize="12" Foreground="#64748B"/>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Monto final contado (USD)" FontSize="12"
                                       FontWeight="SemiBold" Foreground="#64748B"/>
                            <TextBox Text="{Binding ClosingAmountText}"
                                     Watermark="0.00"
                                     CornerRadius="8" Padding="12 10" FontSize="14"/>
                        </StackPanel>

                        <Button Command="{Binding CloseSessionCommand}"
                                IsEnabled="{Binding !IsLoading}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                CornerRadius="8" Padding="12 13"
                                Background="#DC2626" Foreground="White"
                                FontWeight="Bold" FontSize="14">
                            Cerrar Caja
                        </Button>
                    </StackPanel>
                </Border>

            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
