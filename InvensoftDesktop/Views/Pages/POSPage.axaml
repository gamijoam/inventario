<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:InvensoftDesktop.ViewModels"
             x:Class="InvensoftDesktop.Views.Pages.POSPage"
             x:DataType="vm:POSViewModel">

    <Grid>

        <!-- ===== MAIN LAYOUT ===== -->
        <Grid ColumnDefinitions="*,340">

            <!-- LEFT: Búsqueda + Carrito -->
            <Grid Grid.Column="0" RowDefinitions="Auto,*">

                <!-- Búsqueda -->
                <Border Grid.Row="0" Background="White" Padding="16 12"
                        BorderThickness="0 0 0 1" BorderBrush="#E2E8F0">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Grid.Column="0"
                                     Text="{Binding SearchText}"
                                     Watermark="Código de barras o nombre del producto…"
                                     CornerRadius="8" Padding="12 10" FontSize="14"/>
                            <Button Grid.Column="1"
                                    Command="{Binding SearchProductCommand}"
                                    IsEnabled="{Binding !IsSearching}"
                                    Margin="8 0 0 0"
                                    CornerRadius="8" Padding="16 10"
                                    Background="#4F46E5" Foreground="White"
                                    FontWeight="SemiBold">
                                Buscar
                            </Button>
                        </Grid>

                        <!-- Resultado de búsqueda -->
                        <Border Background="#EEF2FF" CornerRadius="8" Padding="12 8"
                                IsVisible="{Binding FoundProduct,
                                    Converter={x:Static ObjectConverters.IsNotNull}}">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="{Binding FoundProduct.Name}"
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="#1E293B"/>
                                    <TextBlock Text="{Binding FoundProduct.PriceDisplay}"
                                               FontSize="12" Foreground="#4F46E5"/>
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Command="{Binding AddFoundProductToCartCommand}"
                                        CornerRadius="6" Padding="12 6"
                                        Background="#4F46E5" Foreground="White"
                                        FontSize="12" FontWeight="SemiBold">
                                    + Agregar
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Error búsqueda -->
                        <TextBlock Text="{Binding SearchError}"
                                   FontSize="12" Foreground="#DC2626"
                                   IsVisible="{Binding SearchError,
                                       Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    </StackPanel>
                </Border>

                <!-- Tabla del carrito -->
                <Grid Grid.Row="1" RowDefinitions="Auto,*">

                    <!-- Encabezado tabla -->
                    <Border Grid.Row="0" Background="#F8FAFC" Padding="16 8"
                            BorderThickness="0 0 0 1" BorderBrush="#E2E8F0">
                        <Grid ColumnDefinitions="*,80,90,80,36">
                            <TextBlock Grid.Column="0" Text="Producto"
                                       FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                            <TextBlock Grid.Column="1" Text="Precio"
                                       FontSize="11" FontWeight="SemiBold" Foreground="#64748B"
                                       TextAlignment="Right"/>
                            <TextBlock Grid.Column="2" Text="Cant."
                                       FontSize="11" FontWeight="SemiBold" Foreground="#64748B"
                                       TextAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="Subtotal"
                                       FontSize="11" FontWeight="SemiBold" Foreground="#64748B"
                                       TextAlignment="Right"/>
                        </Grid>
                    </Border>

                    <!-- Filas carrito -->
                    <ScrollViewer Grid.Row="1">
                        <StackPanel>

                            <!-- Carrito vacío -->
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Margin="0 48"
                                        Spacing="8"
                                        IsVisible="{Binding !CartHasItems}">
                                <TextBlock Text="🛒" FontSize="40"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="El carrito está vacío"
                                           FontSize="14" Foreground="#94A3B8"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Busca un producto por código o nombre"
                                           FontSize="12" Foreground="#CBD5E1"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding Cart}"
                                          IsVisible="{Binding CartHasItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="16 10"
                                                BorderThickness="0 0 0 1"
                                                BorderBrush="#F1F5F9">
                                            <Grid ColumnDefinitions="*,80,90,80,36">
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Name}"
                                                           FontSize="13" Foreground="#1E293B"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding PriceDisplay}"
                                                           FontSize="12" Foreground="#64748B"
                                                           TextAlignment="Right"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding Quantity}"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           Foreground="#1E293B"
                                                           TextAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="3"
                                                           Text="{Binding SubtotalDisplay}"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           Foreground="#059669"
                                                           TextAlignment="Right"
                                                           VerticalAlignment="Center"/>
                                                <Button Grid.Column="4"
                                                        CommandParameter="{Binding}"
                                                        Background="Transparent"
                                                        Padding="4" FontSize="14"
                                                        Foreground="#94A3B8"
                                                        VerticalAlignment="Center">
                                                    ✕
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- RIGHT: Panel de cobro -->
            <Border Grid.Column="1" Background="White"
                    BorderThickness="1 0 0 0" BorderBrush="#E2E8F0">
                <Grid RowDefinitions="*,Auto">

                    <!-- Info total -->
                    <StackPanel Grid.Row="0" Margin="20" Spacing="16">

                        <!-- Success / Error -->
                        <Border Background="#F0FDF4" CornerRadius="8" Padding="12 8"
                                IsVisible="{Binding SuccessMessage,
                                    Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Text="{Binding SuccessMessage}"
                                       Foreground="#15803D" FontSize="12"
                                       TextWrapping="Wrap"/>
                        </Border>
                        <Border Background="#FEF2F2" CornerRadius="8" Padding="12 8"
                                IsVisible="{Binding ErrorMessage,
                                    Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Text="{Binding ErrorMessage}"
                                       Foreground="#DC2626" FontSize="12"
                                       TextWrapping="Wrap"/>
                        </Border>

                        <!-- Total -->
                        <Border Background="#F8FAFC" CornerRadius="10" Padding="16">
                            <StackPanel Spacing="4">
                                <TextBlock Text="TOTAL"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="#64748B"/>
                                <TextBlock Text="{Binding TotalUSD, StringFormat=$\{0:F2\}}"
                                           FontSize="32" FontWeight="Black"
                                           Foreground="#1E293B"/>
                            </StackPanel>
                        </Border>

                        <!-- Ítems count -->
                        <TextBlock FontSize="12" Foreground="#94A3B8">
                            <Run Text="{Binding Cart.Count}"/>
                            <Run Text=" producto(s) en el carrito"/>
                        </TextBlock>

                    </StackPanel>

                    <!-- Botones acción -->
                    <StackPanel Grid.Row="1" Margin="20" Spacing="8">
                        <Button Command="{Binding OpenPaymentCommand}"
                                IsEnabled="{Binding CartHasItems}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                CornerRadius="8" Padding="12 14"
                                Background="#4F46E5" Foreground="White"
                                FontWeight="Bold" FontSize="15">
                            Cobrar
                        </Button>
                        <Button Command="{Binding ClearCartCommand}"
                                IsEnabled="{Binding CartHasItems}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                CornerRadius="8" Padding="10 10"
                                Background="Transparent" Foreground="#64748B"
                                FontSize="13">
                            Limpiar carrito
                        </Button>
                    </StackPanel>

                </Grid>
            </Border>

        </Grid>

        <!-- ===== MODAL COBRO ===== -->
        <Border Background="#60000000"
                IsVisible="{Binding IsPaymentOpen}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <Border Background="White" CornerRadius="16"
                    Width="380" Padding="28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BoxShadow="0 8 32 0 #30000000">
                <StackPanel Spacing="16">

                    <TextBlock Text="Cobro" FontSize="20" FontWeight="Black"
                               Foreground="#1E293B"/>

                    <!-- Total a cobrar -->
                    <Border Background="#F0FDF4" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Total a cobrar"
                                       FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                            <TextBlock Text="{Binding TotalUSD, StringFormat=$\{0:F2\}}"
                                       FontSize="28" FontWeight="Black" Foreground="#059669"/>
                        </StackPanel>
                    </Border>

                    <!-- Monto recibido -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Monto recibido (USD)" FontSize="12"
                                   FontWeight="SemiBold" Foreground="#64748B"/>
                        <TextBox Text="{Binding PaidAmountText}"
                                 Watermark="0.00"
                                 CornerRadius="8" Padding="12 10" FontSize="16"/>
                    </StackPanel>

                    <!-- Cambio -->
                    <Border Background="#F8FAFC" CornerRadius="8" Padding="12 8"
                            IsVisible="{Binding ChangeDisplay,
                                Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="Cambio:"
                                       FontSize="13" Foreground="#64748B"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding ChangeDisplay}"
                                       FontSize="14" FontWeight="Bold"
                                       Foreground="#1E293B"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Error modal -->
                    <Border Background="#FEF2F2" CornerRadius="8" Padding="10 8"
                            IsVisible="{Binding ErrorMessage,
                                Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="#DC2626" FontSize="12" TextWrapping="Wrap"/>
                    </Border>

                    <!-- Botones -->
                    <Grid ColumnDefinitions="*,*" HorizontalAlignment="Stretch">
                        <Button Grid.Column="0"
                                Command="{Binding ClosePaymentCommand}"
                                Margin="0 0 6 0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                CornerRadius="8" Padding="12 12"
                                Background="#F1F5F9" Foreground="#64748B"
                                FontWeight="SemiBold">
                            Cancelar
                        </Button>
                        <Button Grid.Column="1"
                                Command="{Binding ConfirmSaleCommand}"
                                IsEnabled="{Binding !IsProcessing}"
                                Margin="6 0 0 0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                CornerRadius="8" Padding="12 12"
                                Background="#4F46E5" Foreground="White"
                                FontWeight="Bold">
                            <Panel>
                                <TextBlock Text="Procesando…" IsVisible="{Binding IsProcessing}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Confirmar" IsVisible="{Binding !IsProcessing}"
                                           HorizontalAlignment="Center"/>
                            </Panel>
                        </Button>
                    </Grid>

                </StackPanel>
            </Border>
        </Border>

    </Grid>
</UserControl>
