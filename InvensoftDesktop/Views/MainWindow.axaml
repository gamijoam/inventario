<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:InvensoftDesktop.ViewModels"
        xmlns:pages="using:InvensoftDesktop.Views.Pages"
        x:Class="InvensoftDesktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Invensoft"
        Width="1200" Height="760"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9">

    <Grid ColumnDefinitions="220,*">

        <!-- ===== SIDEBAR ===== -->
        <Border Grid.Column="0" Background="#1E293B">
            <Grid RowDefinitions="Auto,*,Auto">

                <!-- Logo -->
                <Border Grid.Row="0" Padding="20 24 20 16"
                        BorderThickness="0 0 0 1" BorderBrush="#2D3F55">
                    <StackPanel Spacing="4">
                        <TextBlock Text="📦 Invensoft"
                                   FontSize="18" FontWeight="Black"
                                   Foreground="White"/>
                        <TextBlock Text="Gestión Empresarial"
                                   FontSize="11" Foreground="#64748B"/>
                    </StackPanel>
                </Border>

                <!-- Nav Items -->
                <StackPanel Grid.Row="1" Spacing="2" Margin="12 16 12 0">

                    <!-- Dashboard -->
                    <Button Command="{Binding GoToDashboardCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            CornerRadius="8" Padding="12 10"
                            Background="#3B4F6B">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="🏠" FontSize="16"/>
                            <TextBlock Text="Dashboard"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="White"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- POS -->
                    <Button Command="{Binding GoToPOSCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            CornerRadius="8" Padding="12 10"
                            Background="Transparent">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="🛒" FontSize="16"/>
                            <TextBlock Text="Punto de Venta"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="White"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Productos -->
                    <Button Command="{Binding GoToProductsCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            CornerRadius="8" Padding="12 10"
                            Background="Transparent">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="📦" FontSize="16"/>
                            <TextBlock Text="Productos"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="White"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Caja -->
                    <Button Command="{Binding GoToCashCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            CornerRadius="8" Padding="12 10"
                            Background="Transparent">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="💰" FontSize="16"/>
                            <TextBlock Text="Caja"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="White"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Clientes -->
                    <Button Command="{Binding GoToCustomersCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            CornerRadius="8" Padding="12 10"
                            Background="Transparent">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="👤" FontSize="16"/>
                            <TextBlock Text="Clientes"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Empleados -->
                    <Button Command="{Binding GoToEmployeesCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            CornerRadius="8" Padding="12 10"
                            Background="Transparent">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="👷" FontSize="16"/>
                            <TextBlock Text="Empleados"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Compras -->
                    <Button Command="{Binding GoToPurchasesCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            CornerRadius="8" Padding="12 10"
                            Background="Transparent">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="🚚" FontSize="16"/>
                            <TextBlock Text="Compras"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Inventario -->
                    <Button Command="{Binding GoToInventoryCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            CornerRadius="8" Padding="12 10"
                            Background="Transparent">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="📋" FontSize="16"/>
                            <TextBlock Text="Inventario"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Reportes -->
                    <Button Command="{Binding GoToReportsCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            CornerRadius="8" Padding="12 10"
                            Background="Transparent">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="📊" FontSize="16"/>
                            <TextBlock Text="Reportes" FontSize="13" FontWeight="SemiBold"
                                       Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Separador Fase 3 -->
                    <Border Height="1" Background="#2D3F55" Margin="8 6"/>

                    <!-- Servicios -->
                    <Button Command="{Binding GoToServicesCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            CornerRadius="8" Padding="12 10"
                            Background="Transparent">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="🔧" FontSize="16"/>
                            <TextBlock Text="Servicios" FontSize="13" FontWeight="SemiBold"
                                       Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Cotizaciones -->
                    <Button Command="{Binding GoToQuotesCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            CornerRadius="8" Padding="12 10"
                            Background="Transparent">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="📄" FontSize="16"/>
                            <TextBlock Text="Cotizaciones" FontSize="13" FontWeight="SemiBold"
                                       Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Devoluciones -->
                    <Button Command="{Binding GoToReturnsCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            CornerRadius="8" Padding="12 10"
                            Background="Transparent">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="↩" FontSize="16"/>
                            <TextBlock Text="Devoluciones" FontSize="13" FontWeight="SemiBold"
                                       Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- RMA -->
                    <Button Command="{Binding GoToRMACommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            CornerRadius="8" Padding="12 10"
                            Background="Transparent">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="🛡" FontSize="16"/>
                            <TextBlock Text="RMA / Garantía" FontSize="13" FontWeight="SemiBold"
                                       Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Políticas Garantía -->
                    <Button Command="{Binding GoToWarrantiesCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            CornerRadius="8" Padding="12 10"
                            Background="Transparent">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="📋" FontSize="14"/>
                            <TextBlock Text="Garantías" FontSize="13" FontWeight="SemiBold"
                                       Foreground="#94A3B8" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                </StackPanel>

                <!-- Bottom: Logout -->
                <Border Grid.Row="2" Padding="12 12"
                        BorderThickness="0 1 0 0" BorderBrush="#2D3F55">
                    <Button Command="{Binding LogoutCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            CornerRadius="8" Padding="12 10"
                            Background="Transparent">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="🚪" FontSize="16"/>
                            <TextBlock Text="Cerrar Sesión"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="#EF4444"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Border>

            </Grid>
        </Border>

        <!-- ===== CONTENT AREA ===== -->
        <Grid Grid.Column="1" RowDefinitions="Auto,*">

            <!-- Header -->
            <Border Grid.Row="0" Background="White" Padding="24 0"
                    BorderThickness="0 0 0 1" BorderBrush="#E2E8F0"
                    Height="56">
                <TextBlock Text="{Binding CurrentPageTitle}"
                           FontSize="16" FontWeight="Black"
                           Foreground="#1E293B"
                           VerticalAlignment="Center"/>
            </Border>

            <!-- Page Content -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentPage}">
                <ContentControl.DataTemplates>
                    <DataTemplate DataType="vm:DashboardViewModel">
                        <pages:DashboardPage/>
                    </DataTemplate>
                    <DataTemplate DataType="vm:ProductsViewModel">
                        <pages:ProductsPage/>
                    </DataTemplate>
                    <DataTemplate DataType="vm:CashViewModel">
                        <pages:CashPage/>
                    </DataTemplate>
                    <DataTemplate DataType="vm:POSViewModel">
                        <pages:POSPage/>
                    </DataTemplate>
                    <DataTemplate DataType="vm:CustomersViewModel">
                        <pages:CustomersPage/>
                    </DataTemplate>
                    <DataTemplate DataType="vm:EmployeesViewModel">
                        <pages:EmployeesPage/>
                    </DataTemplate>
                    <DataTemplate DataType="vm:PurchasesViewModel">
                        <pages:PurchasesPage/>
                    </DataTemplate>
                    <DataTemplate DataType="vm:InventoryViewModel">
                        <pages:InventoryPage/>
                    </DataTemplate>
                    <DataTemplate DataType="vm:ReportsViewModel">
                        <pages:ReportsPage/>
                    </DataTemplate>
                    <DataTemplate DataType="vm:ServicesViewModel">
                        <pages:ServicesPage/>
                    </DataTemplate>
                    <DataTemplate DataType="vm:QuotesViewModel">
                        <pages:QuotesPage/>
                    </DataTemplate>
                    <DataTemplate DataType="vm:ReturnsViewModel">
                        <pages:ReturnsPage/>
                    </DataTemplate>
                    <DataTemplate DataType="vm:RMAViewModel">
                        <pages:RMAPage/>
                    </DataTemplate>
                    <DataTemplate DataType="vm:WarrantiesViewModel">
                        <pages:WarrantiesPage/>
                    </DataTemplate>
                </ContentControl.DataTemplates>
            </ContentControl>

        </Grid>
    </Grid>
</Window>
