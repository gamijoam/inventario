<Window x:Class="Invensoft_Windows_Bridge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Invensoft Bridge" Height="600" Width="400"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <StackPanel x:Name="SetupPanel">
            <TextBlock Text="🔗 Vinculación de Caja" FontSize="20" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center"/>
            
            <TextBlock Text="ID de Empresa (Tenant/Subdominio):" Margin="0,5,0,2"/>
            <TextBox x:Name="txtTenantId" Height="30" Padding="5"/>

            <TextBlock Text="Nombre de esta Caja (Client ID):" Margin="0,10,0,2"/>
            <TextBox x:Name="txtClientId" Height="30" Padding="5" Text="caja-1"/>

            <TextBlock Text="Token de Autenticación:" Margin="0,10,0,2"/>
            <TextBox x:Name="txtToken" Height="30" Padding="5"/>

            <TextBlock Text="Dirección del Servidor (WebSocket):" Margin="0,10,0,2"/>
            <TextBox x:Name="txtHost" Height="30" Padding="5" Text="ws://localhost:8000"/>

            <TextBlock Text="Nombre Impresora (Windows):" Margin="0,10,0,2"/>
            <TextBox x:Name="txtPrinter" Height="30" Padding="5" Text="POS-58"/>

            <CheckBox x:Name="chkVirtualMode" Content="Modo Virtual (Pruebas - Guardar en Desktop)" Margin="0,15,0,0"/>

            <Button x:Name="btnSave" Content="Guardar y Conectar" Height="40" Margin="0,20,0,0" Click="BtnSave_Click"/>
        </StackPanel>

        <StackPanel x:Name="StatusPanel" Visibility="Collapsed">
            <TextBlock Text="✅ Conectado" FontSize="24" FontWeight="Bold" Foreground="Green" HorizontalAlignment="Center" Margin="0,20,0,10"/>
            <TextBlock x:Name="lblStatus" Text="Esperando trabajos de impresión..." HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
            
            <Button Content="Desvincular" Height="30" Width="100" Margin="0,20,0,0" Click="BtnUnlink_Click"/>
            <Button Content="Ocultar (System Tray)" Height="30" Width="150" Margin="0,10,0,0" Click="BtnHide_Click"/>
        </StackPanel>
    </Grid>
</Window>
