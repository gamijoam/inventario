<Window x:Class="Invensoft_Windows_Bridge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Miinventariofacil Impresion" Height="600" Width="400"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <!-- 1. PANTALLA DE BIENVENIDA (Default) -->
        <StackPanel x:Name="WelcomePanel" VerticalAlignment="Top">
            <TextBlock Text="🖨️" FontSize="40" HorizontalAlignment="Center"/>
            <TextBlock Text="Puente de Impresión" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,5,0,5"/>
            
            <TextBlock x:Name="lblStatus" Text="Esperando conexión..." FontSize="14" Foreground="#888" HorizontalAlignment="Center" Margin="0,10,0,10" FontStyle="Italic"/>

            <!-- CONSOLA DE LOGS (Siempre visible para debugging) -->
            <TextBlock Text="📜 Registros de Depuración:" Margin="0,10,0,2" FontWeight="Bold"/>
            <TextBox x:Name="txtLogs" Height="150" VerticalScrollBarVisibility="Auto" IsReadOnly="True" Background="#F8F8F8" FontFamily="Consolas" TextWrapping="Wrap" Padding="5"/>

            <Button Content="⚙️ Ver Configuración Manual" Margin="0,15,0,0" Background="#DDDDDD" Click="BtnManualConfig_Click"/>
        </StackPanel>

        <!-- 2. PANTALLA DE CONFIGURACIÓN MANUAL (Oculta por defecto, toggleable) -->
        <Border x:Name="SetupPanel" Visibility="Collapsed" Background="White" BorderBrush="#CCC" BorderThickness="1" CornerRadius="5" Padding="15" Margin="0,0,0,0">
            <StackPanel>
                <Button Content="❌ Cerrar Configuración" HorizontalAlignment="Right" Background="Transparent" BorderBrush="Transparent" Foreground="Red" Click="BtnBackToWelcome_Click"/>
                
                <TextBlock Text="🛠️ Configuración Manual" FontSize="16" FontWeight="Bold" Margin="0,0,0,10" HorizontalAlignment="Center"/>
                
                <TextBlock Text="Opciones de Inicio:" Margin="0,10,0,2" FontWeight="Bold"/>
                <CheckBox x:Name="chkAutoStart" Content="🚀 Iniciar con Windows" Margin="0,5,0,5" Checked="ChkAutoStart_Checked" Unchecked="ChkAutoStart_Unchecked"/>
                
                <TextBlock Text="Configuración de Impresora:" Margin="0,10,0,2" FontWeight="Bold"/>
                <TextBlock Text="Nombre de la Impresora (Windows):" Margin="0,2,0,2"/>
                <TextBox x:Name="txtPrinter" Height="25" Padding="5" Text="POS-58"/>
                
                <CheckBox x:Name="chkVirtualMode" Content="🧪 Modo Virtual (Guardar ticket en Escritorio)" Margin="0,5,0,5" Checked="ChkVirtualMode_Changed" Unchecked="ChkVirtualMode_Changed"/>
 
                <TextBlock Text="Ancho de Papel:" Margin="0,10,0,2" FontWeight="Bold"/>
                <ComboBox x:Name="cmbPaperWidth" Height="25" Margin="0,0,0,5">
                    <ComboBoxItem Content="58mm (Estándar)" IsSelected="True" Tag="58"/>
                    <ComboBoxItem Content="80mm (Grande)" Tag="80"/>
                </ComboBox>

                <TextBlock Text="Datos de Conexión:" Margin="0,10,0,2" FontWeight="Bold"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,5,0">
                        <TextBlock Text="Tenant ID:" Margin="0,2,0,2"/>
                        <TextBox x:Name="txtTenantId" Height="25" Padding="5"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="5,0,0,0">
                         <TextBlock Text="Caja ID:" Margin="0,2,0,2"/>
                         <TextBox x:Name="txtClientId" Height="25" Padding="5" Text="caja-1"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Token de Acceso:" Margin="0,5,0,2"/>
                <PasswordBox x:Name="txtTokenBox" Height="25" Padding="5"/>

                <TextBlock Text="Servidor WebSocket:" Margin="0,5,0,2"/>
                <TextBox x:Name="txtHost" Height="25" Padding="5" Text="ws://127.0.0.1:8000"/>

                <Button x:Name="btnSave" Content="💾 Guardar y Reiniciar Conexión" Height="35" Margin="0,15,0,0" Click="BtnSave_Click" Background="#4CAF50" Foreground="White" FontWeight="Bold"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
